# Copy to .env (never commit it). The showcase also reads the Immune repository's .env.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Budget guards: calls per run, and dollars across all runs (tracked in ~/.immune/demo-spend.json)
DEMO_MAX_CALLS=80
DEMO_BUDGET_USD=3.00
# LangSmith (optional): without these, traces go to a local HTML report in runs/
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=immune-showcase
